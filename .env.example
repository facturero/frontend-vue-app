# URL del API: apunta al GATEWAY (no directo a auth-service)
VITE_API_URL=http://localhost:8080

# Opcional: para el botón de Google. Debe ser el MISMO Client ID que usa auth-service.
# Si se deja vacío o con el placeholder, el botón de Google no se muestra.
VITE_GOOGLE_CLIENT_ID=

# Opcional: dónde vive el sitio público de reservas (reservas-web). Por defecto https://reservas.noahsolution.com.
# En local: http://localhost:5180
VITE_RESERVATIONS_URL=
